    {
      "name": "Get Trips Since Timestamp (Incremental Sync)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/trips?since=1704000000000",
          "host": ["{{baseUrl}}"],
          "path": ["trips"],
          "query": [
            {
              "key": "since",
              "value": "1704000000000",
              "description": "Unix timestamp in milliseconds. Only returns trips updated after this time."
